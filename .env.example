APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# One-shot: GET /programme-wipe-run?key=<secret> (optional &app_settings=1). Remove route after use. Min. 8 chars.
# PROGRAMME_WIPE_SECRET=

# One-shot: GET /migration-run?key=<secret> runs pending migrations. Remove from .env after use. Min. 8 chars.
# MIGRATION_RUN_SECRET=

# Comma-separated user IDs allowed to log social media posts (state_staff). Falls back to name "Sanjna Mishra" if empty.
# SOCIAL_MEDIA_POST_SUBMITTER_IDS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Legacy Phase 2 (rbiphase2) — read-only, for php artisan import:legacy-monthly-targets
# LEGACY_DB_CONNECTION=mysql
# LEGACY_DB_HOST=127.0.0.1
# LEGACY_DB_PORT=3306
# LEGACY_DB_DATABASE=rbiphase2
# LEGACY_DB_USERNAME=root
# LEGACY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
MUY_SESSION_COOKIE=muy_phase3_session
# Production APP_URL includes /phase3, so this defaults to /phase3 automatically.
# MUY_SESSION_PATH=/phase3

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Incubatee portal — used when running: php artisan incubatees:provision-users (override in .env)
INCUBATEE_DEFAULT_PASSWORD=Muy@2026
# Optional: domain for placeholder logins when CFA has no email (incubatee-{id}@domain). Empty = APP_URL host.
# INCUBATEE_SYNTHETIC_EMAIL_DOMAIN=ukrbi.in
